from dataclasses import dataclass

import sympy as sp
from sympy import Poly, QQ
from sympy.polys.matrices import DomainMatrix


# --------------------------------------------------------------------------
# Outils
# --------------------------------------------------------------------------

def _ratio(expr, n, k):
    """Simplifie un quotient de termes hypergéométriques en fraction rationnelle."""
    e = sp.gammasimp(sp.expand_func(expr).rewrite(sp.gamma))
    e = sp.powsimp(sp.expand_power_exp(e))
    e = sp.cancel(sp.together(e))
    if not e.is_rational_function(n, k):
        e = sp.cancel(sp.simplify(e))
        if not e.is_rational_function(n, k):
            raise ValueError(
                "Le terme ne semble pas hypergéométrique en (n, k) : "
                f"le rapport se simplifie en {e}"
            )
    return e


def _poly(expr, k, K):
    return Poly(expr, k, domain=K)


def _shift(P, s, k, K):
    """Renvoie le polynôme P(k + s)."""
    return Poly(P.as_expr().subs(k, k + s), k, domain=K)


def _nonneg_integer_shifts(a, b, k, params):
    """Entiers h >= 0 tels que pgcd(a(k), b(k+h)) != 1 (via le résultant en k)."""
    if a.degree() <= 0 or b.degree() <= 0:
        return []
    h = sp.Dummy("h")
    ae = sp.numer(sp.together(a.as_expr()))
    be = sp.numer(sp.together(b.as_expr().subs(k, k + h)))
    res = sp.numer(sp.together(sp.resultant(ae, be, k)))
    if res == 0:
        return []
    shifts = set()
    _, facs = sp.factor_list(res)
    for f, _mult in facs:
        if f.has(h) and not any(f.has(p) for p in params):
            p = Poly(f, h)
            if p.degree() == 1:
                root = sp.solve(f, h)[0]
                if root.is_Integer and root >= 0:
                    shifts.add(int(root))
    return sorted(shifts)


def _gosper_form(num, den, k, K, params):
    """
    rho = num/den  ->  (a, b, c) polynômes en k avec rho = a/b * c(k+1)/c(k)
    et pgcd(a(k), b(k+h)) = 1 pour tout entier h >= 0.
    """
    a = _poly(num, k, K)
    b = _poly(den, k, K)
    c = _poly(1, k, K)
    while True:
        shifts = _nonneg_integer_shifts(a, b, k, params)
        if not shifts:
            return a, b, c
        h = shifts[0]
        g = a.gcd(_shift(b, h, k, K))
        if g.degree() <= 0:      # sécurité
            return a, b, c
        a = a.quo(g)
        b = b.quo(_shift(g, -h, k, K))
        for i in range(1, h + 1):
            c = c * _shift(g, -i, k, K)


def _degree_bound_x(a, b, deg_c, k):
    """Borne supérieure sur deg x pour  a(k)x(k+1) - b(k-1)x(k) = c(k), deg c <= deg_c."""
    da, db = a.degree(), b.degree()
    lca, lcb = a.LC(), b.LC()
    if da != db or sp.cancel(lca - lcb) != 0:
        return deg_c - max(da, db)
    d = da
    a1 = a.coeff_monomial(k ** (d - 1)) if d >= 1 else 0
    b1 = b.coeff_monomial(k ** (d - 1)) if d >= 1 else 0
    B1 = b1 - d * lca                       # coefficient de k^(d-1) dans b(k-1)
    bound = deg_c - d + 1
    m0 = sp.cancel((B1 - a1) / lca)
    if m0.is_Integer and m0 >= 0:
        bound = max(bound, int(m0))
    return bound


# --------------------------------------------------------------------------
# Résultat
# --------------------------------------------------------------------------

@dataclass
class ZeilbergerResult:
    order: int
    coeffs: list          # [c_0(n), ..., c_r(n)]
    certificate: sp.Expr  # R(n, k), avec G(n, k) = R(n, k) * F(n, k)
    n: sp.Symbol
    k: sp.Symbol

    def recurrence(self):
        n = self.n
        terms = [f"({sp.factor(c)})*A({n}+{j})" if j else f"({sp.factor(c)})*A({n})"
                 for j, c in enumerate(self.coeffs)]
        return " + ".join(terms) + " = 0"

    def __str__(self):
        return (f"Ordre r = {self.order}\n"
                f"Recurrence : {self.recurrence()}\n"
                f"Certificat R(n,k) = {sp.factor(self.certificate)}")


# --------------------------------------------------------------------------
# Algorithme de Zeilberger
# --------------------------------------------------------------------------

def zeilberger(F, n, k, max_order=6, verbose=False):
    """
    Renvoie un ZeilbergerResult pour le terme hypergéométrique F(n, k),
    ou None si aucune récurrence d'ordre <= max_order n'est trouvée.
    """
    params = sorted(F.free_symbols - {k}, key=str)
    if n not in params:
        params.append(n)
    K = QQ.frac_field(*params)

    rho_k = _ratio(F.subs(k, k + 1) / F, n, k)     # F(n,k+1)/F(n,k)
    R = {0: sp.Integer(1)}                         # R[j] = F(n+j,k)/F(n,k)

    for r in range(1, max_order + 1):
        for j in range(1, r + 1):
            if j not in R:
                R[j] = _ratio(F.subs(n, n + j) / F, n, k)

        # --- dénominateur commun D(k) et numérateurs N_j (D/D_j) ---
        Nj, Dj = [], []
        for j in range(r + 1):
            num, den = sp.fraction(sp.cancel(R[j]))
            Nj.append(_poly(num, k, K))
            Dj.append(_poly(den, k, K))
        D = Dj[0]
        for p in Dj[1:]:
            D = D.lcm(p)
        Pcols = [Nj[j] * D.quo(Dj[j]) for j in range(r + 1)]   # P = sum C_j * Pcols[j]

        # --- forme de Gosper de rho(k) = F(k+1)/F(k) * D(k)/D(k+1) ---
        D_expr = D.as_expr()
        rho = sp.cancel(rho_k * D_expr / D_expr.subs(k, k + 1))
        num, den = sp.fraction(rho)
        a, b, c0 = _gosper_form(num, den, k, K, params)
        b_m1 = _shift(b, -1, k, K)                 # b(k-1)

        # --- borne de degré pour x ---
        deg_c = c0.degree() + max(p.degree() for p in Pcols)
        mx = _degree_bound_x(a, b, deg_c, k)
        if mx < 0:
            continue

        # --- système linéaire : colonnes = [C_0..C_r, X_0..X_mx] ---
        cols = [-(c0 * p) for p in Pcols]
        for i in range(mx + 1):
            xi = Poly(k ** i, k, domain=K)
            cols.append(a * _shift(xi, 1, k, K) - b_m1 * xi)

        nrows = max(max(p.degree() for p in cols), 0) + 1
        M = sp.zeros(nrows, len(cols))
        for ci, p in enumerate(cols):
            coeffs = p.all_coeffs()[::-1]
            for ri, v in enumerate(coeffs):
                M[ri, ci] = v

        dM = DomainMatrix.from_Matrix(M).convert_to(K)
        ns = dM.nullspace().to_Matrix()            # une ligne par vecteur de base

        sol = None
        for row in range(ns.rows):
            vec = list(ns.row(row))
            if any(sp.cancel(v) != 0 for v in vec[: r + 1]):
                sol = vec
                break
        if verbose:
            print(f"r = {r}: deg x <= {mx}, matrice {M.shape}, "
                  f"{'solution trouvée' if sol else 'pas de solution'}")
        if sol is None:
            continue

        # --- normalisation : coefficients c_j polynomiaux et premiers entre eux ---
        sol = [sp.cancel(v) for v in sol]
        den_l = sp.lcm([sp.fraction(v)[1] for v in sol])
        sol = [sp.cancel(v * den_l) for v in sol]
        g = sp.gcd_list([v for v in sol[: r + 1] if v != 0])
        sol = [sp.cancel(v / g) for v in sol]

        cs = [sp.expand(v) for v in sol[: r + 1]]
        xs = sol[r + 1:]
        x_expr = sum(xv * k ** i for i, xv in enumerate(xs))

        cert = sp.cancel(
            b_m1.as_expr() * x_expr / (c0.as_expr() * D.as_expr())
        )

        # --- vérification : sum c_j R_j = R(k+1) rho_k - R(k) ---
        lhs = sum(cs[j] * R[j] for j in range(r + 1))
        rhs = cert.subs(k, k + 1) * rho_k - cert
        if sp.cancel(sp.together(lhs - rhs)) != 0:
            raise RuntimeError("Vérification du certificat échouée (bug ?)")

        return ZeilbergerResult(order=r, coeffs=cs, certificate=cert, n=n, k=k)

    return None


# --------------------------------------------------------------------------
# Vérification numérique de la récurrence sur la somme
# --------------------------------------------------------------------------

def check_recurrence(F, res, n, k, kmin, kmax, n_values=range(1, 8)):
    """
    Vérifie numériquement sum_j c_j(n) A_{n+j} = 0 avec A_m = sum_{k=kmin}^{kmax} F(m, k).
    kmin, kmax : entiers ou expressions en n. Renvoie True si tout est cohérent.
    """
    def A(m):
        lo = int(sp.sympify(kmin).subs(n, m))
        hi = int(sp.sympify(kmax).subs(n, m))
        return sum(F.subs({n: m, k: kk}) for kk in range(lo, hi + 1))

    ok = True
    for m in n_values:
        total = sum(c.subs(n, m) * A(m + j) for j, c in enumerate(res.coeffs))
        if sp.simplify(total) != 0:
            ok = False
            print(f"  n = {m} : reste {sp.simplify(total)} (bords non nuls ?)")
    return ok


